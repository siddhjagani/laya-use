{
  "manifest_version": 3,
  "name": "Jev",
  "version": "0.1.0",
  "description": "Chat with a local browser agent that works on the tab you are viewing.",
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1:8767/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Jev" },
  "side_panel": { "default_path": "panel.html" }
}
